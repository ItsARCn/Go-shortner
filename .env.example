# Server Configuration
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
APP_ENV=development

# Database
DB_PATH=./data/go-dev.sqlite

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
SESSION_DURATION_HOURS=72

# Quotas & Limits
ANONYMOUS_DAILY_QUOTA=15
REGISTERED_MONTHLY_QUOTA=100
ANONYMOUS_MAX_EXPIRATION_DAYS=7
REGISTERED_MAX_EXPIRATION_DAYS=365

# Super Admin Bootstrap (Only used if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeOnFirstLogin123!

# CAPTCHA (Optional in local dev, Cloudflare Turnstile in prod)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase Auth (Optional in local dev, configured for Google Auth)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
